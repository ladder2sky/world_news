# Ollama配置
OLLAMA_BASE_URL=http://localhost:11434

# AI模型配置
AI_MODEL_LIGHT=qwen2.5:3b
AI_MODEL_MAIN=qwen2.5:7b

# 日报配置
AI_TOP_N=20
AI_SCREEN_N=50

# 抓取配置
NEWS_AGE_HOURS=24
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_DELAY=1

# 评分阈值
SCORE_THRESHOLD_TOP=70

# TTS配置
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 日志级别
LOG_LEVEL=INFO

# 运行模式 (full / incremental / manual)
RUN_MODE=full
